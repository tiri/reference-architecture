{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@platform/shared-ui": ["../../shared-ui/src/index.ts"],
      "@platform/shared-ui/src/*": ["../../shared-ui/src/*"],
      // shared-ui is compiled from source, so its files resolve React's types next to
      // themselves — a second physical copy of the same version, which TypeScript treats
      // as unrelated. One copy for both trees.
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
