<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Shared by the metastore and by Impala's daemons: the metastore reads it to find its own
  database, Impala reads it to find the metastore. The images ship no configuration at
  all, so without this file Impala starts an embedded metastore of its own and fails.
-->
<configuration>
  <!-- The metastore's own storage: Derby, embedded, in the shared volume. Matches the
       path the image's entrypoint probes when it decides whether to create the schema. -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=/var/lib/hive/metastore/metastore_db;create=true</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.apache.derby.jdbc.EmbeddedDriver</value>
  </property>
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>false</value>
  </property>

  <!-- Impala asks the metastore for its notification event id before any DDL. Without
       the listener the metastore has no event sequence to answer from and every CREATE
       fails with an internal error. -->
  <property>
    <name>hive.metastore.transactional.event.listeners</name>
    <value>org.apache.hive.hcatalog.listener.DbNotificationListener</value>
  </property>
  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>

  <!-- What Impala needs: the metastore is a separate service, not embedded. -->
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/var/lib/hive/warehouse</value>
  </property>
</configuration>
