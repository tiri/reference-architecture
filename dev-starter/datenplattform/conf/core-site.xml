<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  No HDFS in the sandbox: the warehouse is a plain directory in a shared volume. The
  records themselves live in Kudu, not in files, so this only has to be valid.
-->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>file:///</value>
  </property>
</configuration>
